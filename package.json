{
  "name": "evo-crm-community",
  "version": "1.0.0",
  "description": "Evolution CRM Community - Monorepo",
  "private": true,
  "scripts": {
    "git": "./scripts/git-sync.sh",
    "push": "./scripts/build-push.sh",
    "push:all": "./scripts/build-push.sh --processor",
    "push:processor": "./scripts/build-push.sh --processor-only",
    "push:frontend": "./scripts/build-push.sh --frontend-only",
    "push:flow": "./scripts/build-push.sh --flow-only",
    "push:local": "./scripts/build-push.sh --local",
    "push:all:local": "./scripts/build-push.sh --processor --local",
    "push:processor:local": "./scripts/build-push.sh --processor-only --local",
    "push:frontend:local": "./scripts/build-push.sh --frontend-only --local",
    "push:flow:local": "./scripts/build-push.sh --flow-only --local",
    "push:crm": "./scripts/push-image.sh evo-crm ghcr.io/ericocesar/evo-ai-crm-community",
    "push:crm:local": "docker compose build evo-crm",
    "push:auth": "./scripts/push-image.sh evo-auth ghcr.io/ericocesar/evo-auth-service-community",
    "push:auth:local": "docker compose build evo-auth",
    "push:core": "./scripts/push-image.sh evo-core ghcr.io/ericocesar/evo-ai-core-service-community",
    "push:core:local": "docker compose build evo-core",
    "push:bot-runtime": "./scripts/push-image.sh evo-bot-runtime ghcr.io/ericocesar/evo-bot-runtime",
    "push:bot-runtime:local": "docker compose build evo-bot-runtime",
    "push:gateway": "./scripts/push-image.sh evo-gateway ghcr.io/ericocesar/evo-crm-gateway",
    "push:gateway:local": "docker compose build evo-gateway",
    "push:everything": "pnpm push:crm && pnpm push:auth && pnpm push:core && pnpm push:bot-runtime && pnpm push:gateway && pnpm push:processor && pnpm push:frontend && pnpm push:flow"
  }
}
