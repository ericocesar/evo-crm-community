# =============================================================================
# BChat CRM Community — Swarm Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.swarm.example .env
#
# Then deploy:
#   docker stack deploy -c docker-compose.swarm.yaml evo_crm
# =============================================================================

# =============================================================================
# DOMAINS (only 2 needed)
# =============================================================================
API_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com

# =============================================================================
# SHARED SECRETS
# =============================================================================
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
DOORKEEPER_JWT_SECRET_KEY=CHANGE_ME

# Generate with: openssl rand -hex 32
EVOAI_CRM_API_TOKEN=CHANGE_ME
BOT_RUNTIME_SECRET=CHANGE_ME

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=evo_community
POSTGRES_SSLMODE=require

# =============================================================================
# REDIS
# =============================================================================
# Password used both in REDIS_URL and standalone (required by cable.yml, healthchecks)
REDIS_PASSWORD=your-redis-password

# Used by auth, crm, bot-runtime
REDIS_URL=redis://:${REDIS_PASSWORD}@your-redis-host:6379/0

# Used by processor (separate vars)
PROCESSOR_REDIS_HOST=your-redis-host
PROCESSOR_REDIS_PORT=6379
PROCESSOR_REDIS_PASSWORD=your-redis-password
PROCESSOR_REDIS_DB=0

# Processor postgres connection string
PROCESSOR_POSTGRES_CONNECTION_STRING=postgresql://postgres:CHANGE_ME@your-postgres-host:5432/evo_community?sslmode=require

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
MAILER_SENDER_EMAIL=noreply@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# OPTIONAL
# =============================================================================
MFA_ISSUER=EvoCRM
SIDEKIQ_CONCURRENCY=10
ACTIVE_STORAGE_SERVICE=local
ORGANIZATION_NAME=BChat CRM

# =============================================================================
# EVO-FLOW (Journeys / Campaigns)
# =============================================================================
EVOFLOW_DOMAIN=flow.example.com

# PostgreSQL database for evo-flow (defaults to evo_community if not set)
# Set to a separate DB name only if you create that database first
EVOFLOW_DB=evo_community

# ClickHouse credentials (used by evo-flow for analytics)
CLICKHOUSE_USER=evoflow
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=evo_flow
